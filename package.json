{
  "name": "sidebar-terminal",
  "version": "0.1.3",
  "private": true,
  "description": "Independent terminals, tabs and split panes for Obsidian desktop.",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && npm run lint && node scripts/check-lines.mjs && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts && node scripts/test-bridge.mjs",
    "install:plugin": "node scripts/install.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check src scripts tests/*.ts",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@xterm/headless": "6.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1"
  },
  "author": "Rhynelabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhynelabs/sidebar-terminal.git"
  },
  "homepage": "https://github.com/rhynelabs/sidebar-terminal#readme",
  "bugs": {
    "url": "https://github.com/rhynelabs/sidebar-terminal/issues"
  }
}
